# Quinlo — environment template.
# Copy to .env and fill in secrets. Never commit a real .env.
#
# Naming note: the QUINLO_ prefix comes from branding.json (envPrefix).
# If the product is renamed, decide whether to keep this prefix for
# compatibility — see NAMING.md.

# --- Required in production -------------------------------------------
# Vault master key: encrypts all stored secrets (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Losing it makes vault secrets unrecoverable. No default in production.
QUINLO_MASTER_KEY=

# Postgres credentials for docker compose (also used in DATABASE_URL).
POSTGRES_USER=quinlo
POSTGRES_PASSWORD=
POSTGRES_DB=quinlo

# --- Deployment --------------------------------------------------------
# Public base URL of this deployment (used in preview/deploy links).
QUINLO_BASE_URL=http://localhost
# Host Caddy listens on (a real domain gets automatic TLS).
QUINLO_HOST=localhost
# Direct database URL (compose sets this from the Postgres vars above).
# Unset = in-memory store (dev/tests only; data does not survive restart).
# DATABASE_URL=postgres://quinlo:password@db:5432/quinlo

# --- Server tuning (defaults shown) ------------------------------------
PORT=3000
HOST=0.0.0.0
QUINLO_DATA_DIR=./data
QUINLO_FUNCTION_TIMEOUT_MS=5000
QUINLO_RATE_LIMIT_MAX=300
QUINLO_RATE_LIMIT_WINDOW_MS=60000
QUINLO_MAX_UPLOAD_BYTES=10485760
QUINLO_SESSION_TTL_MS=604800000
QUINLO_STRIPE_API_BASE_URL=https://api.stripe.com

# --- Demo seed (DEV ONLY — never enable in production) -----------------
# Creates demo@quinlo.local with the password below, plus a demo org,
# app, collection, profiles, and starter frontend.
QUINLO_SEED_DEMO=false
# Default demo password used when QUINLO_DEMO_PASSWORD is unset:
# demo-password-123 (local throwaway use only).
QUINLO_DEMO_PASSWORD=

# --- OAuth providers (optional; enables Google/GitHub sign-in) ---------
# Register an OAuth app with each provider; redirect URI:
#   <QUINLO_BASE_URL>/api/v1/auth/oauth/<provider>/callback
QUINLO_OAUTH_GOOGLE_CLIENT_ID=
QUINLO_OAUTH_GOOGLE_CLIENT_SECRET=
QUINLO_OAUTH_GITHUB_CLIENT_ID=
QUINLO_OAUTH_GITHUB_CLIENT_SECRET=

# --- GitHub sync testing (do NOT enable in production) -----------------
# Allows file:// remotes for local bare-repo testing.
QUINLO_ALLOW_LOCAL_GIT_REMOTES=false
