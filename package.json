{"description":"OpenForge (working title) — self-hostable AI App Factory. Clean-room original code; see INVENTORY.md and NAMING.md.","devDependencies":{"@types/node":"^24.0.0","esbuild":"^0.24.0","typescript":"^5.7.0"},"engines":{"node":">=20"},"name":"openforge","private":true,"scripts":{"build":"tsc -b --verbose tsconfig.json && npm run build:web","build:web":"node scripts/build-web.mjs","dev":"npm run build && node apps/server/dist/index.js","lint:branding":"node scripts/check-branding.mjs","start":"node apps/server/dist/index.js","test":"npm run build && node --test \"packages/*/dist/**/*.test.js\" \"apps/server/dist/**/*.test.js\"","test:quick":"node --test \"packages/*/dist/**/*.test.js\" \"apps/server/dist/**/*.test.js\"","typecheck":"tsc -b --verbose tsconfig.json && tsc -p apps/web/tsconfig.json --noEmit","verify:compose":"python3 -c \"import yaml,sys; [yaml.safe_load(open(f)) for f in ['docker-compose.yml']]; print('compose YAML OK')\""},"version":"0.1.0","workspaces":["apps/*","packages/*"]}